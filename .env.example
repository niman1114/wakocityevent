# Web Push / notification settings (set these in the Vercel project settings)
# VAPID keys: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Subscription storage (Upstash Redis, created from the Vercel dashboard Storage tab)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron-notify (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
